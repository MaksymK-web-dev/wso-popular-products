{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wso/popular-products",
  "version": "1.0.0",
  "title": "Popular Products",
  "category": "widgets",
  "icon": "cart",
  "description": "Shows the store's best-selling products, fetched from the REST API without a page reload.",
  "keywords": ["woocommerce", "products", "popular", "bestsellers"],
  "textdomain": "wso-popular-products",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "background": true,
      "text": true
    }
  },
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Popular products"
    },
    "limit": {
      "type": "number",
      "default": 3
    },
    "showPrice": {
      "type": "boolean",
      "default": true
    },
    "showImage": {
      "type": "boolean",
      "default": true
    }
  },
  "editorScript": "file:./assets/edit.js",
  "editorStyle": "file:./assets/editor.css",
  "style": "file:./assets/style.css",
  "viewScriptModule": "file:./assets/view.js",
  "render": "file:./render.php"
}
