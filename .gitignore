# This plugin lives inside a WordPress install on the author's machine, so the
# repository tracks only the plugin itself. Deny by default, then re-include.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.env.example
!/LICENSE
!/README.md
!/CHANGELOG.md
!/composer.json
!/composer.lock
!/phpcs.xml.dist
!/phpunit.xml.dist
!/.github/
!/tests/
!/docs/
!/blocks/
!/tools/
!/src/
!/autoload.php
!/wso-popular-products.php

# Never ship editor folders, dependencies or caches
/.idea/
/.vscode/
/vendor/
/node_modules/
/.phpunit.cache/
/.phpcs.cache
*.log
.DS_Store
Thumbs.db
